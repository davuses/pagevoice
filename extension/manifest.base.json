{
  "manifest_version": 3,
  "name": "PageVoice — Read Aloud",
  "version": "3.0.0",
  "description": "Read web pages aloud with local Kokoro or Pocket TTS, or Google Translate.",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "read-selection": {
      "suggested_key": { "default": "Alt+S" },
      "description": "Read the selected text aloud"
    }
  },
  "permissions": ["activeTab", "contextMenus", "notifications", "storage"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["styles.css"],
      "js": ["content.js"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
